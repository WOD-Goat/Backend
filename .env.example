# Copy to .env and fill in. NEVER commit .env.
# Use a TEST/EMULATOR project for local development and tests, not production.

PORT=3000
NODE_ENV=development

# Environment guard: production | staging | development | test
# Leave unset locally (= development). Set to staging on the staging deployment.
# Unset on Vercel is treated as production (requires the production FIREBASE_PROJECT_ID).
# test requires FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST and a non-production project.
APP_ENV=

# Auth
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=
FIREBASE_DATABASE_URL=

# Gemini via Vertex AI (voice workouts, @google/genai)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Service-account JSON as a single line (needed on Vercel; locally ADC also works)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Minimum mobile app version (x.y.z); older clients are forced to update. Defaults to 1.0.0 if unset.
MIN_APP_VERSION=1.0.0

# RevenueCat webhook
REVENUECAT_WEBHOOK_SECRET=
