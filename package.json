{
  "name": "backend-api",
  "version": "1.0.0",
  "description": "Fitness app backend API",
  "main": "dist/app.js",
  "engines": {
    "node": "24.x",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node app.ts",
    "dev:watch": "nodemon --exec ts-node app.ts",
    "seed:exercises": "ts-node scripts/seedExercises.ts",
    "seed:staging": "ts-node scripts/seedStagingViaApi.ts",
    "check:staging-cache": "ts-node scripts/checkStagingProgramCache.ts",
    "check:staging-submit": "ts-node scripts/checkStagingSubmit.ts",
    "check:staging-skip": "ts-node scripts/checkStagingSkip.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@types/node": "^24.2.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "expo-server-sdk": "3.14.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0",
    "vercel": "^50.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
